---
interface Props {
  alt?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  size?: 144;
}

const {
  alt = '',
  class: className,
  loading = 'lazy',
  size = 144,
} = Astro.props;
const source = `/assets/brand/beaver-a1-${size}.png`;
const doubleSource = `/assets/brand/beaver-a1-${size * 2}.png`;
---

<img
  src={source}
  srcset={`${source} 1x, ${doubleSource} 2x`}
  alt={alt}
  class:list={['beaver-character', className]}
  width={size}
  height={size}
  loading={loading}
  decoding="async"
/>
