---
import StudyFlow from '@/components/StudyFlow';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { curricula, paths, units } from '@/lib/content/catalog';
import { renderMarkdown } from '@/lib/content/render';
import { mentalModels } from '@/lib/content/mental-models';
import '@/styles/task-focus.css';

export const prerender = true;

export function getStaticPaths() {
  return units.map((unit) => ({
    params: { unit: unit.metadata.slug },
    props: { unit },
  }));
}

const { unit } = Astro.props;
const kcnaPath = paths.find((path) => path.slug === 'kcna');
const kcnaCurriculum = curricula.find((curriculum) => curriculum.slug === 'kcna-kodekloud');
const courseUnitIds = kcnaCurriculum
  ? [...new Set(kcnaCurriculum.modules.flatMap((module) => module.steps.flatMap((step) => step.unit_ids)))]
  : [];
const kcnaUnitIds = kcnaPath
  ? [...courseUnitIds.filter((id) => kcnaPath.units.some((entry) => entry.unit_id === id)), ...kcnaPath.units.map((entry) => entry.unit_id).filter((id) => !courseUnitIds.includes(id))]
  : [];
const kcnaIndex = kcnaUnitIds.indexOf(unit.metadata.id);
const isKcnaUnit = kcnaIndex >= 0;
const nextKcnaUnit = isKcnaUnit && kcnaIndex + 1 < kcnaUnitIds.length
  ? units.find((candidate) => candidate.metadata.id === kcnaUnitIds[kcnaIndex + 1])
  : null;
const payload = {
  id: unit.metadata.id,
  revision: unit.metadata.revision,
  title: unit.metadata.title,
  summary: unit.metadata.summary,
  layer: unit.metadata.layer,
  estimatedMinutes: unit.metadata.estimated_minutes,
  questions: unit.questions,
  cards: unit.cards,
  practices: unit.practices,
  sources: unit.sources,
  visuals: unit.visuals,
  lessonHtml: renderMarkdown(unit.markdown),
  mentalModels: mentalModels.filter((model) => model.unit_ids.includes(unit.metadata.id)).map(({ slug, title, summary }) => ({ slug, title, summary })),
};
---

<BaseLayout
  title={unit.metadata.title}
  description={unit.metadata.summary}
  canonicalPath={'/learn/' + unit.metadata.slug}
  pageClass="unit-page"
  activeSection="learn"
>
  <StudyFlow
    unit={payload}
    focus={isKcnaUnit ? { href: '/kcna', label: 'KCNA focus' } : undefined}
    nextUnit={nextKcnaUnit ? { href: `/learn/${nextKcnaUnit.metadata.slug}`, title: nextKcnaUnit.metadata.title } : undefined}
    client:load
  />
</BaseLayout>
