---
import SettingsClient from '@/components/SettingsClient';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Settings & export" description="Owner scheduling and portable learner export.">
  <header class="page-hero shell compact-hero">
    <p class="eyebrow">Settings</p>
    <h1>Learning preferences & export</h1>
    <p class="lede">OAuth identity gates persistence; exports keep the data yours.</p>
  </header>
  <section class="shell settings-shell"><SettingsClient client:load /></section>
</BaseLayout>
