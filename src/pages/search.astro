---
import SearchClient from '@/components/SearchClient';
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout title="Search" description="Exact public search across published DevOps learning content.">
  <header class="page-hero shell compact-hero">
    <p class="eyebrow">Search</p>
    <h1>Find a concept</h1>
    <p class="lede">Exact search across reviewed public learning content.</p>
  </header>
  <section class="shell"><SearchClient client:load /></section>
</BaseLayout>
