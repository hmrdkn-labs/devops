---
import AnatomyLayout from '@/layouts/AnatomyLayout.astro';
import Figure from '@/components/anatomy/pod-lifecycle/Figure';
import { anatomyPagesBySlug } from '@/lib/anatomy/catalog';
import explanation from '../../../content/anatomy/pod-lifecycle.md?raw';
import { renderMarkdown } from '@/lib/content/render';

export const prerender = true;
const entry = anatomyPagesBySlug.get('pod-lifecycle');
if (!entry) throw new Error('Missing pod-lifecycle Anatomy metadata');
---
<AnatomyLayout entry={entry}>
  <Figure slot="figure" client:load />
  <div set:html={renderMarkdown(explanation, { scrollContainers: true })} />
</AnatomyLayout>
