---
import AnatomyLayout from '@/layouts/AnatomyLayout.astro';
import Figure from '@/components/anatomy/scheduling-placement/Figure';
import { anatomyPagesBySlug } from '@/lib/anatomy/catalog';
import explanation from '../../../content/anatomy/scheduling-placement.md?raw';
import { renderMarkdown } from '@/lib/content/render';

export const prerender = true;
const entry = anatomyPagesBySlug.get('scheduling-placement');
if (!entry) throw new Error('Missing scheduling-placement Anatomy metadata');
---
<AnatomyLayout entry={entry}>
  <Figure slot="figure" client:load />
  <div set:html={renderMarkdown(explanation, { scrollContainers: true })} />
</AnatomyLayout>
