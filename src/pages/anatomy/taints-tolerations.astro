---
import AnatomyLayout from '@/layouts/AnatomyLayout.astro';
import Figure from '@/components/anatomy/taints-tolerations/Figure';
import { anatomyPagesBySlug } from '@/lib/anatomy/catalog';
import explanation from '../../../content/anatomy/taints-tolerations.md?raw';
import { renderMarkdown } from '@/lib/content/render';

export const prerender = true;
const entry = anatomyPagesBySlug.get('taints-tolerations');
if (!entry) throw new Error('Missing taints-tolerations Anatomy metadata');
---
<AnatomyLayout entry={entry}>
  <Figure slot="figure" client:load />
  <div set:html={renderMarkdown(explanation, { scrollContainers: true })} />
</AnatomyLayout>
