---
import AnatomyLayout from '@/layouts/AnatomyLayout.astro';
import Figure from '@/components/anatomy/service-endpoints/Figure';
import { anatomyPagesBySlug } from '@/lib/anatomy/catalog';
import explanation from '../../../content/anatomy/service-endpoints.md?raw';
import { renderMarkdown } from '@/lib/content/render';

export const prerender = true;
const entry = anatomyPagesBySlug.get('service-endpoints');
if (!entry) throw new Error('Missing service-endpoints Anatomy metadata');
---
<AnatomyLayout entry={entry}>
  <Figure slot="figure" client:load />
  <div set:html={renderMarkdown(explanation, { scrollContainers: true })} />
</AnatomyLayout>
