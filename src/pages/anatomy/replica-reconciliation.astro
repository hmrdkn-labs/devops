---
import AnatomyLayout from '@/layouts/AnatomyLayout.astro';
import { anatomyPagesBySlug } from '@/lib/anatomy/catalog';
import Figure from '@/components/anatomy/replica-reconciliation/Figure';
import explanation from '../../../content/anatomy/replica-reconciliation.md?raw';
import { renderMarkdown } from '@/lib/content/render';

export const prerender = true;
const entry = anatomyPagesBySlug.get('replica-reconciliation');
if (!entry) throw new Error('Missing replica-reconciliation Anatomy metadata');
---
<AnatomyLayout entry={entry}>
  <Figure slot="figure" client:load />
  <div set:html={renderMarkdown(explanation, { scrollContainers: true })} />
</AnatomyLayout>
