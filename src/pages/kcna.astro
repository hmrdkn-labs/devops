---
import KcnaFocusClient from '@/components/KcnaFocusClient';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { curricula, lessons, paths, unitsById } from '@/lib/content/catalog';

export const prerender = true;

const path = paths.find((candidate) => candidate.slug === 'kcna');
if (!path) throw new Error('KCNA path is missing');
const curriculum = curricula.find((candidate) => candidate.slug === 'kcna-kodekloud');
if (!curriculum) throw new Error('KCNA course curriculum is missing');

const pathWeights = new Map(path.units.map((entry) => [entry.unit_id, entry.weight]));
const pathUnitIds = new Set(path.units.map((entry) => entry.unit_id));
const seenUnits = new Set<string>();
const clientUnits: Array<{ id: string; slug: string; title: string; estimatedMinutes: number; checkpointId: string }> = [];

const modules = curriculum.modules.map((module) => {
  const unitIds = [...new Set(module.steps.flatMap((step) => step.unit_ids).filter((id) => pathUnitIds.has(id)))];
  for (const unitId of unitIds) {
    if (seenUnits.has(unitId)) continue;
    const unit = unitsById.get(unitId);
    if (!unit) continue;
    seenUnits.add(unitId);
    clientUnits.push({
      id: unit.metadata.id,
      slug: unit.metadata.slug,
      title: unit.metadata.title,
      estimatedMinutes: unit.metadata.estimated_minutes,
      checkpointId: module.slug,
    });
  }
  return { ...module, unitIds };
});

// Future KCNA units remain reachable even before they are mapped into the
// external course spine.
for (const entry of path.units) {
  if (seenUnits.has(entry.unit_id)) continue;
  const unit = unitsById.get(entry.unit_id);
  if (!unit) continue;
  clientUnits.push({
    id: unit.metadata.id,
    slug: unit.metadata.slug,
    title: unit.metadata.title,
    estimatedMinutes: unit.metadata.estimated_minutes,
    checkpointId: 'unmapped',
  });
}

const clientCheckpoints = modules.map((module) => ({
  id: module.slug,
  title: module.title,
  unitIds: module.unitIds,
}));

const stepHref = (moduleSlug: string, step: (typeof modules)[number]['steps'][number]) => {
  if (step.kind === 'quiz') return `/practice/kcna?module=${moduleSlug}`;
  if (step.kind === 'mock-exam') return '/practice/kcna?mode=all';
  if (step.kind === 'feedback') return '/review?path=kcna';
  const firstUnit = step.unit_ids.map((id) => unitsById.get(id)).find(Boolean);
  return firstUnit ? `/learn/${firstUnit.metadata.slug}` : null;
};

const stepAction = (kind: string) => ({
  lesson: 'Study',
  demo: 'Practice concept',
  quiz: 'Practice questions',
  feedback: 'Review',
  'mock-exam': 'Start mock practice',
  conclusion: 'Review course',
  community: 'Course step',
})[kind] ?? 'Open';

const mappedUnit = (step: (typeof modules)[number]['steps'][number]) =>
  step.unit_ids.map((id) => unitsById.get(id)).find(Boolean);
const mappedUnits = (step: (typeof modules)[number]['steps'][number]) =>
  step.unit_ids.flatMap((id) => {
    const unit = unitsById.get(id);
    return unit ? [unit] : [];
  });

const reviewUnits = path.units.flatMap((entry) => {
  const unit = unitsById.get(entry.unit_id);
  return unit && unit.metadata.slug.startsWith('kcna-') && unit.metadata.slug.endsWith('-review') ? [unit] : [];
});
const totalSteps = modules.reduce((total, module) => total + module.steps.length, 0);
---

<BaseLayout
  title="KCNA learning path"
  description="KCNA learning material arranged in the current KodeKloud course sequence, with independent explanations, practice, and review."
  canonicalPath="/kcna"
  pageClass="kcna-page"
  activeSection="kcna"
>
  <header class="kcna-hero shell">
    <div class="kcna-hero-copy">
      <p class="eyebrow">Learn · KCNA</p>
      <h1>KCNA learning path</h1>
      <p class="lede">Follow the same module and lesson progression as the current KodeKloud KCNA course, using our own explanations, retrieval practice, and review.</p>
      <p class="kcna-course-source">
        <strong>{modules.length} modules · {totalSteps} course steps</strong>
        <span>Sequence verified {curriculum.verified_at}.</span>
        <a href={curriculum.reference.url} rel="noreferrer">Course reference ↗</a>
      </p>
    </div>
  </header>

  <div class="shell kcna-today-shell">
    <KcnaFocusClient units={clientUnits} checkpoints={clientCheckpoints} client:load />
  </div>

  <div class="shell path-curriculum-shell">
    <section class="kcna-curriculum" aria-label="KCNA curriculum in course order">
      {modules.map((module, moduleIndex) => (
        <details
          id={module.slug}
          class="kcna-checkpoint kcna-course-module"
          data-checkpoint={module.slug}
          open={moduleIndex === 0}
        >
          <summary>
            <span>{String(moduleIndex + 1).padStart(2, '0')}</span>
            <div>
              <p class="section-kicker">Module {moduleIndex + 1}</p>
              <h2>{module.title}</h2>
              <p>{module.summary}</p>
            </div>
            <div class="kcna-checkpoint-meta">
              <span class="kcna-checkpoint-state" data-checkpoint-progress={module.slug}>Not started</span>
              <small>{module.steps.length} steps</small>
            </div>
          </summary>

          <ol class="kcna-course-steps">
            {module.steps.map((step, stepIndex) => {
              const href = stepHref(module.slug, step);
              const unit = mappedUnit(step);
              const units = mappedUnits(step);
              const weight = unit ? pathWeights.get(unit.metadata.id) : undefined;
              return (
                <li class="kcna-course-step" data-course-step={step.id} data-unit-id={unit?.metadata.id}>
                  <span class="kcna-unit-number">{String(stepIndex + 1).padStart(2, '0')}</span>
                  <div class="kcna-course-step-copy">
                    <div class="kcna-course-step-title">
                      <strong>{step.title}</strong>
                      <span class={`kcna-step-kind is-${step.kind}`}>{step.kind.replace('-', ' ')}</span>
                    </div>
                    {unit ? (
                      <p>
                        Our material:
                        <span class="kcna-step-materials">
                          {units.map((mapped) => (
                            <a data-mapped-unit-id={mapped.metadata.id} href={`/learn/${mapped.metadata.slug}`}>{mapped.metadata.title}</a>
                          ))}
                        </span>
                      </p>
                    ) : (
                      <p>Course navigation step; no standalone learning unit is required.</p>
                    )}
                  </div>
                  <div class="kcna-course-step-action">
                    {step.duration && <span>{step.duration}</span>}
                    {weight === 2 && <span class="critical-badge">Critical</span>}
                    {href && <a href={href}>{stepAction(step.kind)} →</a>}
                  </div>
                </li>
              );
            })}
          </ol>
        </details>
      ))}
    </section>
  </div>

  <section class="shell path-extras" aria-labelledby="path-extras-title">
    <h2 id="path-extras-title">Extra practice and lookup</h2>
    <p><a href="/practice/kcna">KCNA question practice →</a> · <a href="/library">Browse the library</a> · <a href="/paths/kcna">32-unit concept outline</a></p>
    <details>
      <summary>Guided lessons, mental models, and scheduled review</summary>
      <p><a href="/models/">Interactive mental models</a> · <a href="/review?path=kcna">Scheduled KCNA review</a></p>
      <ul>
        {lessons.filter((lesson) => lesson.certification === 'cncf:kcna').map((lesson) => (
          <li><a href={`/lesson/${lesson.slug}`}>{lesson.title}</a> · {lesson.exercises.length} interactions</li>
        ))}
        {reviewUnits.map((unit) => <li><a href={`/learn/${unit.metadata.slug}`}>{unit.metadata.title}</a></li>)}
      </ul>
    </details>
  </section>
</BaseLayout>
