---
import KcnaFocusClient from '@/components/KcnaFocusClient';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { lessons, paths, unitsById } from '@/lib/content/catalog';

export const prerender = true;

const path = paths.find((candidate) => candidate.slug === 'kcna');
if (!path) throw new Error('KCNA path is missing');

const pathUnits = path.units.flatMap((entry, index) => {
  const unit = unitsById.get(entry.unit_id);
  return unit ? [{ unit, index, weight: entry.weight }] : [];
});

const checkpoints = [
  {
    id: 'fundamentals',
    title: 'Kubernetes Fundamentals',
    note: 'Machines, containers, and the control plane.',
    start: 0,
    end: 9,
  },
  {
    id: 'resources',
    title: 'Kubernetes Resources',
    note: 'Pods, controllers, namespaces, and declarative resources.',
    start: 9,
    end: 18,
  },
  {
    id: 'cluster-behavior',
    title: 'Cluster Behavior',
    note: 'Networking, scheduling, storage, configuration, and access.',
    start: 18,
    end: 26,
  },
  {
    id: 'cloud-native',
    title: 'Cloud-Native Context',
    note: 'Delivery, observability, troubleshooting, and the CNCF ecosystem.',
    start: 26,
    end: pathUnits.length,
  },
].map((checkpoint) => ({
  ...checkpoint,
  units: pathUnits.slice(checkpoint.start, checkpoint.end),
  lesson: lessons.find((lesson) => lesson.certification === 'cncf:kcna' && lesson.checkpoint === checkpoint.id),
}));

const reviewUnits = pathUnits.filter(({ unit }) => unit.metadata.slug.startsWith('kcna-') && unit.metadata.slug.endsWith('-review'));
const clientUnits = checkpoints.flatMap((checkpoint) => checkpoint.units.map(({ unit }) => ({
  id: unit.metadata.id,
  slug: unit.metadata.slug,
  title: unit.metadata.title,
  estimatedMinutes: unit.metadata.estimated_minutes,
  checkpointId: checkpoint.id,
})));
const clientCheckpoints = checkpoints.map((checkpoint) => ({
  id: checkpoint.id,
  title: checkpoint.title,
  unitIds: checkpoint.units.map(({ unit }) => unit.metadata.id),
}));
---

<BaseLayout
  title="KCNA learning path"
  description="A focused KCNA study workspace containing only the KCNA learning path, checkpoints, and review companions."
  canonicalPath="/kcna"
  pageClass="kcna-page"
  activeSection="kcna"
>
  <header class="kcna-hero shell">
    <div class="kcna-hero-copy">
      <p class="eyebrow">Learn · KCNA</p>
      <h1>KCNA learning path</h1>
      <p class="lede">Build your Kubernetes foundations one unit at a time. Start your next step or browse the four sections below.</p>
    </div>
  </header>

  <div class="shell kcna-today-shell">
    <KcnaFocusClient units={clientUnits} checkpoints={clientCheckpoints} client:load />
  </div>

  <div class="shell path-curriculum-shell">
    <section class="kcna-curriculum" aria-label="KCNA curriculum">
      {checkpoints.map((checkpoint, checkpointIndex) => (
        <details id={checkpoint.id} class="kcna-checkpoint" data-checkpoint={checkpoint.id} open={checkpointIndex === 0}>
          <summary>
            <span>{String(checkpointIndex + 1).padStart(2, '0')}</span>
            <div>
              <p class="section-kicker">Section {checkpointIndex + 1}</p>
              <h2>{checkpoint.title}</h2>
              <p>{checkpoint.note}</p>
            </div>
            <div class="kcna-checkpoint-meta">
              <span class="kcna-checkpoint-state" data-checkpoint-progress={checkpoint.id}>Not started</span>
              <small>{checkpoint.units.length} units</small>
            </div>
          </summary>
          {checkpoint.lesson && (
            <a class="kcna-lesson-launch" href={'/lesson/' + checkpoint.lesson.slug}>
              <span class="section-kicker">Interactive lesson</span>
              <strong>Learn {checkpoint.title} by doing →</strong>
              <small>{checkpoint.lesson.exercises.length} focused interactions · about {checkpoint.lesson.estimated_minutes} minutes</small>
            </a>
          )}
          <ol>
            {checkpoint.units.map(({ unit, index, weight }) => (
              <li data-unit-id={unit.metadata.id}>
                <span class="kcna-unit-number">{String(index + 1).padStart(2, '0')}</span>
                <a href={'/learn/' + unit.metadata.slug}>
                  <strong>{unit.metadata.title}</strong>
                </a>
                <div class="kcna-unit-meta">
                  <span title="Learning completion" class="kcna-completion-state" data-unit-completion={unit.metadata.id}>Not started</span>
                  <span title="Understanding evidence" class="kcna-understanding-state" data-unit-understanding={unit.metadata.id}>No evidence</span>
                  {weight === 2 && <span class="critical-badge">Critical</span>}
                  <span>{unit.metadata.estimated_minutes} min</span>
                </div>
                <details class="path-unit-details"><summary>Unit details</summary><p>{unit.metadata.summary}</p><small>{unit.metadata.layer}</small></details>
              </li>
            ))}
          </ol>
        </details>
      ))}
    </section>
  </div>
  <section class="shell path-extras" aria-labelledby="path-extras-title">
    <h2 id="path-extras-title">Optional practice and lookup</h2>
    <p><a href="/practice">Choose a practice activity →</a> · <a href="/library">Browse the library</a> · <a href="/paths/kcna">Full path outline</a></p>
    <details><summary>Quiz companions and practice tools</summary>
      <p><a href="/practice/kcna">MCQ practice</a> · <a href="/models/">Interactive mental models</a> · <a href="/review?path=kcna">Scheduled KCNA review</a></p>
      <ul>{reviewUnits.map(({ unit }) => <li><a href={'/learn/' + unit.metadata.slug}>{unit.metadata.title}</a></li>)}</ul>
    </details>
  </section>
</BaseLayout>
