---
import KcnaFocusClient from '@/components/KcnaFocusClient';
import BrandMark from '@/components/BrandMark.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { paths, unitsById } from '@/lib/content/catalog';

export const prerender = true;
const path = paths.find((candidate) => candidate.slug === 'kcna');
if (!path) throw new Error('KCNA path is missing');
const sections = [
  { id: 'fundamentals', title: 'Kubernetes Fundamentals', start: 0, end: 9 },
  { id: 'resources', title: 'Kubernetes Resources', start: 9, end: 18 },
  { id: 'cluster-behavior', title: 'Cluster Behavior', start: 18, end: 26 },
  { id: 'cloud-native', title: 'Cloud-Native Context', start: 26, end: path.units.length },
];
const pathUnits = path.units.map((entry) => unitsById.get(entry.unit_id));
const clientUnits = sections.flatMap((section) => pathUnits.slice(section.start, section.end).flatMap((unit) => unit ? [{
  id: unit.metadata.id, slug: unit.metadata.slug, title: unit.metadata.title,
  estimatedMinutes: unit.metadata.estimated_minutes, checkpointId: section.id,
}] : []));
const checkpoints = sections.map((section) => ({
  id: section.id, title: section.title,
  unitIds: clientUnits.filter((unit) => unit.checkpointId === section.id).map((unit) => unit.id),
}));
---

<BaseLayout title="Learn" activeSection="learn" description="Start or resume a concrete DevOps learning task.">
  <header class="page-hero shell compact-hero home-welcome">
    <div>
      <p class="eyebrow">Learn</p>
      <h1>Your next learning task</h1>
      <p class="lede">Work through the KCNA path one unit at a time. Read when a concept is new, then explain and apply it.</p>
    </div>
    <BrandMark class="home-welcome-mark" size={144} loading="eager" />
  </header>
  <div class="shell learn-entry">
    <KcnaFocusClient units={clientUnits} checkpoints={checkpoints} compact showProgress={false} client:load />
    <section class="entry-context" aria-labelledby="current-path-title">
      <div>
        <p class="section-kicker">Current path</p>
        <h2 id="current-path-title">KCNA learning path</h2>
        <p>{clientUnits.length} connected units, from the machine underneath Kubernetes to cloud-native operations.</p>
        <a href="/kcna">Browse the full path outline →</a>
      </div>
      <div>
        <p class="section-kicker">New to containers?</p>
        <h2>An image is not a running container</h2>
        <p>An image is stored input. A container adds a process, writable state, isolation, logs, and an exit status.</p>
        <a href="/learn/container-lifecycle?mode=reference">See the concrete example →</a>
      </div>
    </section>
  </div>
</BaseLayout>
