---
import KcnaFocusClient from '@/components/KcnaFocusClient';
import BrandCharacter from '@/components/BrandCharacter.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { curricula, paths, unitsById } from '@/lib/content/catalog';

export const prerender = true;
const path = paths.find((candidate) => candidate.slug === 'kcna');
if (!path) throw new Error('KCNA path is missing');
const curriculum = curricula.find((candidate) => candidate.slug === 'kcna-domains');
if (!curriculum) throw new Error('KCNA domain curriculum is missing');
const pathUnitIds = new Set(path.units.map((entry) => entry.unit_id));
const clientUnits = curriculum.modules.flatMap((module) => {
  const mappedIds = [...new Set(module.steps.flatMap((step) => step.unit_ids))].filter((id) => pathUnitIds.has(id));
  return mappedIds.flatMap((id) => {
    const unit = unitsById.get(id);
    return unit ? [{
      id: unit.metadata.id, slug: unit.metadata.slug, title: unit.metadata.title,
      estimatedMinutes: unit.metadata.estimated_minutes, checkpointId: module.slug,
    }] : [];
  });
});
const checkpoints = curriculum.modules.map((module) => ({
  id: module.slug, title: module.title,
  unitIds: clientUnits.filter((unit) => unit.checkpointId === module.slug).map((unit) => unit.id),
}));
---

<BaseLayout
  title="Free, open Kubernetes exam prep"
  activeSection="learn"
  description="Free, open KCNA prep: answer each question first, then see why. No account needed. MIT code, CC BY-SA 4.0 content, full Markdown export."
>
  <header class="page-hero shell compact-hero home-welcome">
    <div>
      <h1>Free, open Kubernetes exam prep. Answer first, then see why.</h1>
      <p class="lede">DevOps by hmrdkn-labs is KCNA prep that needs no account. Code is MIT, content is CC BY-SA 4.0, and every unit downloads as Markdown.</p>
    </div>
    <BrandCharacter class="home-welcome-mark" size={144} loading="eager" />
  </header>
  <div class="shell learn-entry">
    <KcnaFocusClient units={clientUnits} checkpoints={checkpoints} compact showProgress={false} client:load />
    <section class="entry-context" aria-labelledby="current-path-title">
      <div>
        <p class="section-kicker">Current path</p>
        <h2 id="current-path-title">KCNA learning path</h2>
        <p>{clientUnits.length} connected units, from the machine underneath Kubernetes to cloud-native operations.</p>
        <a href="/kcna">Browse the full path outline →</a>
      </div>
      <div>
        <p class="section-kicker">New to containers?</p>
        <h2>An image is not a running container</h2>
        <p>An image is stored input. A container adds a process, writable state, isolation, logs, and an exit status.</p>
        <a href="/learn/container-lifecycle?mode=reference">See the concrete example →</a>
      </div>
    </section>
  </div>
</BaseLayout>
