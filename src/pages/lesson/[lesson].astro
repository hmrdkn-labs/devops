---
import LessonPlayer from '@/components/LessonPlayer';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { lessons } from '@/lib/content/catalog';
import { mentalModels } from '@/lib/content/mental-models';
import type { Lesson } from '@/lib/content/schema';

export const prerender = true;

export function getStaticPaths() {
  return lessons.map((lesson) => ({
    params: { lesson: lesson.slug },
    props: { lesson },
  }));
}

const { lesson } = Astro.props as { lesson: Lesson };
const relatedModels = mentalModels.filter((model) => model.unit_ids.some((id) => lesson.source_unit_ids.includes(id))).map(({ slug, title, summary }) => ({ slug, title, summary }));
---

<BaseLayout
  title={lesson.title}
  description={lesson.summary}
  canonicalPath={'/lesson/' + lesson.slug}
  pageClass="lesson-page"
  activeSection="kcna"
  immersive
>
  <LessonPlayer lesson={lesson} mentalModels={relatedModels} client:load />
</BaseLayout>
