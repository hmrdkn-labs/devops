---
import AuthMenu from '@/components/AuthMenu';
import ThemeToggle from '@/components/ThemeToggle';
import '../styles/global.css';
import '../styles/learner-navigation.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  pageClass?: string;
  activeSection?: 'kcna' | 'learn' | 'review' | 'practice' | 'library';
  immersive?: boolean;
}

const {
  title = 'DevOps by hmrdkn-labs',
  description = 'Build durable DevOps understanding from process to production.',
  canonicalPath = Astro.url.pathname,
  pageClass = '',
  activeSection,
  immersive = false,
} = Astro.props;
const pageTitle = title === 'DevOps by hmrdkn-labs' ? title : `${title} · DevOps by hmrdkn-labs`;
const canonical = new URL(canonicalPath, 'https://devops.hamardikan.com');
const navigation = [
  { id: 'learn', href: '/', label: 'Learn', prefixes: ['/kcna', '/learn', '/paths'] },
  { id: 'review', href: '/review', label: 'Review', prefixes: ['/review'] },
  { id: 'practice', href: '/practice', label: 'Practice', prefixes: ['/practice', '/lesson', '/models'] },
  { id: 'library', href: '/library', label: 'Library', prefixes: ['/library', '/search', '/map', '/references'] },
];
const isCurrent = (item: typeof navigation[number]) => {
  if (activeSection) return item.id === (activeSection === 'kcna' ? 'learn' : activeSection);
  return Astro.url.pathname === item.href || item.prefixes.some((prefix) =>
    Astro.url.pathname === prefix || Astro.url.pathname.startsWith(prefix + '/'));
};
---

<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta id="theme-color" name="theme-color" content="#f7f5f0" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DevOps by hmrdkn-labs" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="DevOps by hmrdkn-labs" />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('hmrdkn-theme');
        const theme = savedTheme === 'light' || savedTheme === 'dark' || savedTheme === 'system' ? savedTheme : 'system';
        const dark = theme === 'dark' || (theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = theme;
        document.querySelector('#theme-color')?.setAttribute('content', dark ? '#151c24' : '#f7f5f0');
      } catch {}
    </script>
    <title>{pageTitle}</title>
  </head>
  <body class={[pageClass, immersive ? 'immersive-page' : ''].filter(Boolean).join(' ')}>
    <a class="skip-link" href="#main">Skip to content</a>
    {!immersive && <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/" aria-label="DevOps by hmrdkn-labs home">
          <img class="brand-mark" src="/favicon.svg" alt="" width="30" height="30" />
          <span class="brand-name">DevOps <small>hmrdkn-labs</small></span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          {navigation.map((item) => (
            <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="header-tools">
          <a class="header-search" href="/search" aria-current={Astro.url.pathname.startsWith('/search') ? 'page' : undefined}>Search</a>
          <ThemeToggle client:load />
          <AuthMenu client:load />
        </div>
      </div>
    </header>}
    <main id="main"><slot /></main>
    {!immersive && <nav class="mobile-dock" aria-label="Primary mobile navigation">
      {navigation.map((item) => (
        <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>
          <span class="mobile-dock-mark" aria-hidden="true"></span>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>}
    {!immersive && <footer class="site-footer">
      <div>
        <strong>DevOps by hmrdkn-labs</strong>
        <p>An independent learning project. Not affiliated with or endorsed by CNCF, Linux Foundation, Kubernetes, Docker, AWS, or KodeKloud.</p>
      </div>
      <div class="footer-links">
        <a href="/references">References</a>
        <a href="/content/v1/manifest.json">Content manifest</a>
        <a href="/devops-content-v1.zip">Markdown archive</a>
        <a href="/llms.txt">llms.txt</a>
        <a href="https://github.com/hmrdkn-labs/devops">GitHub</a>
      </div>
      <p class="license-line">Code and examples: MIT · Prose and original diagrams: CC BY-SA 4.0</p>
    </footer>}
  </body>
</html>
