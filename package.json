{
  "name": "@hmrdkn-labs/devops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.4"
  },
  "overrides": {
    "vite": "8.3.5",
    "esbuild": "0.28.2"
  },
  "scripts": {
    "predev": "npm run content:build",
    "dev": "astro dev",
    "build": "npm run content:build && astro build",
    "preview": "astro dev",
    "start": "astro dev",
    "content:check": "tsx tools/content/build.ts --check",
    "content:build": "tsx tools/content/build.ts",
    "revision:check": "tsx tools/content/revision-check.ts",
    "release:classify": "tsx tools/release/classify.ts",
    "release:manifest": "tsx tools/release/manifest.ts",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:d1": "tsx tools/test-d1.ts",
    "test:e2e": "playwright test",
    "check": "npm run content:check && npm run typecheck && npm test && npm run test:d1",
    "ci": "npm run check && npm run build && npm run release:manifest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.3",
    "@astrojs/solid-js": "7.1.2",
    "astro": "7.4.4",
    "better-auth": "^1.7.15",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "marked": "^18.0.11",
    "sanitize-html": "^2.18.1",
    "solid-js": "1.9.18",
    "ts-fsrs": "^5.4.1",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.6",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "0.31.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite-plus": "^1.4.0",
    "vitest": "^5.0.5",
    "wrangler": "4.156.1"
  }
}
